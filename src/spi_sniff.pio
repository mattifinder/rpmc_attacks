.program spi_sniff

; SPI Sniffer
; When triggered, by a 32-bit value BITCOUNT in the TX fifo, this program
; will wait for CS to go low and then sniff the next BITCOUNT bits from
; MOSI. These are pushed to the RX fifo as multiples of 32-bits.
;
; FIFOs:
; - TX holds 32-bit BITCOUNT values (autopull is enabled).
; - RX transfers the sniffed bits (in 32-bit chunks) (autopush is enabled).
; Pin mapping:
; - in pins: 0 is SPI MOSI (gpio 3)
; - uses gpio pins 2 (SPI CLK)
; - JMPPIN is SPI CS (5)

.define CLK 2

public start:
    ; load bits to match into y
    out y, 32

.wrap_target
match:
    set x, 15               ; bits to match (need to be 32)
    mov isr, null

    ; wait for falling chip select edge
wait_cs:
    wait 1 JMPPIN
    wait 0 JMPPIN

    ; sample the bits to match into x
bitloop:
    ; wait for rising clock edge
    wait 0 gpio CLK
    wait 1 gpio CLK
    in pins, 1
    jmp PIN match           ; break out of bitloop if cs is high
    jmp x--, bitloop

    ; compare read bits
    mov x, isr              ; move bits read to x
    jmp x!=y, match         ; continue if bits don't match

end:
    push                    ; push a null byte if we matched!
.wrap

% c-sdk {
static bool spi_sniff_inited = false;
static PIO spi_sniff_pio;
static uint spi_sniff_sm;
static uint spi_sniff_offset;
static pio_sm_config spi_sniff_cfg;

static void spi_sniff_cleanup() {

    if (!spi_sniff_inited)
        return;

    pio_sm_set_enabled(spi_sniff_pio, spi_sniff_sm, false);
    pio_remove_program(spi_sniff_pio, &spi_sniff_program, spi_sniff_offset);
    pio_sm_unclaim(spi_sniff_pio, spi_sniff_sm);

    spi_sniff_inited = false;
}

static int spi_sniff_init(const unsigned int cs, const unsigned int clk, const unsigned int mosi) {

    spi_sniff_cleanup();

    if (!pio_claim_free_sm_and_add_program(&spi_sniff_program, &spi_sniff_pio, &spi_sniff_sm, &spi_sniff_offset)) {
        printf("Error: SPI sniff program could not be loaded/could not claim state machine!\n");
        return false;
    }

    pio_gpio_init(spi_sniff_pio, clk);
    pio_gpio_init(spi_sniff_pio, mosi);
    pio_gpio_init(spi_sniff_pio, cs);

    spi_sniff_cfg = spi_sniff_program_get_default_config(spi_sniff_offset);

    // io mapping (inputs 0:svd)
    sm_config_set_in_pins(&spi_sniff_cfg, mosi);
    sm_config_set_in_pin_count(&spi_sniff_cfg, 1);

    // shifts are msb-first 32-bits
    sm_config_set_in_shift(&spi_sniff_cfg, false, true, 32);
    sm_config_set_out_shift(&spi_sniff_cfg, false, true, 32);

    // setup cs as jump pins
    sm_config_set_jmp_pin(&spi_sniff_cfg, cs);

    // 125 MHz
    sm_config_set_clkdiv(&spi_sniff_cfg, 1.0f);

    spi_sniff_inited = true;

    // success
    return true;
}

static int spi_trigger(uint16_t match, void (*callback)(void)) {
    int rc = pio_sm_init(spi_sniff_pio, spi_sniff_sm, spi_sniff_offset + spi_sniff_offset_start, &spi_sniff_cfg);
    if (rc < 0) {
        printf("Error: spi sniff sm failed to initialize!\n");
        return rc;
    }
    pio_sm_set_enabled(spi_sniff_pio, spi_sniff_sm, true);
    pio_sm_clear_fifos(spi_sniff_pio, spi_sniff_sm);

    pio_sm_put_blocking(spi_sniff_pio, spi_sniff_sm, match);

    while (true) {
        uint32_t read = pio_sm_get_blocking(spi_sniff_pio, spi_sniff_sm);
        callback();
    }

    pio_sm_set_enabled(spi_sniff_pio, spi_sniff_sm, false);

    return 0;
}

%}
