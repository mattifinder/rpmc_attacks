.program rpmc_sniffer

; SPI Sniffer
; When triggered, by a 32-bit value BITCOUNT in the TX fifo, this program
; will wait for CS to go low and then sniff the next BITCOUNT bits from
; MOSI. These are pushed to the RX fifo as multiples of 32-bits.
;
; FIFOs:
; - TX holds 32-bit BITCOUNT values (autopull is enabled).
; - RX transfers the sniffed bits (in 32-bit chunks) (autopush is enabled).
; Pin mapping:
; - in pins: 0 is SPI MOSI (gpio 3)
; - uses gpio pins 2 (SPI CLK)
; - JMPPIN is SPI CS (5)

.define CLK 2

.wrap_target
public start:
    ; load bits to match into y
    out y, 32

match_loop:
    set x, 15                ; bits to match
    mov isr, null

    ; wait for falling chip select edge
    wait 1 JMPPIN
    wait 0 JMPPIN

    ; sample the bits to match into x on every rising clock edge
bitloop:
    wait 1 gpio CLK
    in pins, 1
    ; make sure that the clock goes down in between
    wait 0 gpio CLK
    jmp x--, bitloop
bitloop_end:

    ; compare read bits
    mov x, isr              ; move bits read to x
    jmp x!=y, match_loop    ; continue if bits don't match
match_success:

    ; a request command is 48 bytes long, and we have read already the first
    ; two, so we're still missing 46*8 bits. since we can't set immediate values
    ; larger than 31, we have to use two counters for an outer loop and an inner
    ; one. 46*8/16 = 23
    ; NOTE: make sure the pico is fast enough for this (overclocking might be
    ;       necessary)
    set y, 22
outerloop:
    set x, 15
innerloop:
    wait 1 gpio CLK
    in pins, 1
    wait 0 gpio CLK
    jmp x--, innerloop
innerloop_end:
    jmp y--, outerloop
outerloop_end:

    ; notify the second state machine that it can start looking for OP2
    irq prev clear 4

    ; jump back to start
.wrap

;-------------------------------------------------------------------------------------------------------------------------;

.program spi_slave
.define CLK 2
.side_set 1 opt

public start:
    ; load bits to match into y
    out y, 32

; TODO this should be moved to match_loop once everything works
.wrap_target
wait_for_request:
    ; wait for the first SM to notify us about a found request command
    irq wait 4

match_loop:
    ; peak at the bit count and abort if it is zero.
    ; get 31 bits so that the pull threshold is not yet met. since we shift out
    ; right, we're missing the LSB of the bit count, which is then cleared by
    ; the mov operation. the bit count thus has to be shifted once to the left
    ; before pushing it into the FIFO
    out x, 31
    jmp !x abort
    ; write back into OSR for later (this also dicards the LSB)
    mov osr, x

    set x, 7                ; bits to match
    mov isr, null

    ; wait for falling chip select edge
    wait 1 JMPPIN
    wait 0 JMPPIN

    ; sample the bits to match into x on every rising clock edge
bitloop:
    wait 1 gpio CLK
    in pins, 1
    ; make sure that the clock goes down in between
    wait 0 gpio CLK
    jmp x--, bitloop
bitloop_end:

    ; compare read bits
    mov x, isr              ; move bits read to x
    jmp x!=y, match_loop    ; continue if bits don't match

match_success:
    ; get the bit count (should be one less than actual) and start muxing
    out x, 32       side 1

write_loop:
    ; write bit to miso before a rising clock edge
    wait 1 gpio CLK
    wait 0 gpio CLK
    out pins, 1
    jmp x--, write_loop
write_loop_end:

    ; set miso to 0xFF and stop muxing
    set pins, 1      side 0

    ; wait for CS to go up again
    ;wait 1 JMPPIN

    ; since we can only push words into the fifo, there might still be some
    ; dummy bits left that have to be cleared
    ; TODO: I think we're clearing one word too much if the bit count was
    ;       divisable by 32.
    out NULL, 32

    ; jump back to wait_for_request
.wrap

abort:
    ; clear the last bit of the OSR
    out null, 1
    jmp wait_for_request

;-------------------------------------------------------------------------------------------------------------------------;

% c-sdk {
struct __attribute((__packed__)) rpmc_command_info {
    uint8_t dummy[2];
    union {
        enum: uint8_t {
            WRITE_ROOT_KEY,
            UPDATE_HMAC_KEY,
            INCREMENT,
            GET,
            UNKNOWN,
        } kind;
        enum : uint8_t{
            WAIT = 0x01,
            DONE = 0x80,
        } status;
    };
    union {
        struct __attribute((__packed__)) {
            uint8_t key_data[4];
            uint8_t tag[12];
            uint8_t signature[32];
            uint8_t _align_pad;
            uint8_t end[0];
            uint8_t counter;
        } update;
        struct __attribute((__packed__)) {
            uint8_t tag[12];
            uint32_t counter;
            uint8_t signature[32];
            uint8_t _align_pad;
            uint8_t end[0];
        } get;
        struct {
            uint8_t target;
            uint32_t old_value;
        } increment;
    };
};

struct pio_metadata {
    PIO pio;
    unsigned int sm;
    unsigned int offset;
    pio_sm_config cfg;
};


static bool rpmc_sniffer_inited = false;
static struct pio_metadata rpmc_sniffer_inst;
static int pin_setter_sm;

static bool interposer_inited = false;
static struct pio_metadata interposer_inst;

void deinit(struct pio_metadata * inst, const pio_program_t * prog)
{
    pio_sm_set_enabled(inst->pio, inst->sm, false);
    pio_remove_program(inst->pio, prog, inst->offset);
    pio_sm_unclaim(inst->pio, inst->sm);
}


static void rpmc_sniffer_cleanup() {

    if (rpmc_sniffer_inited) {
        deinit(&rpmc_sniffer_inst, &rpmc_sniffer_program);
        rpmc_sniffer_inited = false;
    }
}

static int rpmc_sniffer_init(const unsigned int cs, const unsigned int clk, const unsigned int mosi, const unsigned int mux) {

    rpmc_sniffer_cleanup();

    // TODO: switch to pio_add_program with {FIRST,SECOND}_PIO for consistency
    //       for irq prev/next
    if (!pio_claim_free_sm_and_add_program(&rpmc_sniffer_program, &rpmc_sniffer_inst.pio, &rpmc_sniffer_inst.sm, &rpmc_sniffer_inst.offset)) {
        printf("Error: SPI sniff program could not be loaded/could not claim state machine!\n");
        return false;
    }
    printf("rpmc_sniffer: %u\n", PIO_NUM(rpmc_sniffer_inst.pio));

    pio_gpio_init(rpmc_sniffer_inst.pio, clk);
    gpio_set_input_hysteresis_enabled(clk, false);
    pio_gpio_init(rpmc_sniffer_inst.pio, mosi);
    gpio_set_input_hysteresis_enabled(mosi, false);
    pio_gpio_init(rpmc_sniffer_inst.pio, cs);

    pio_gpio_init(rpmc_sniffer_inst.pio, mux);
    pio_sm_set_consecutive_pindirs(rpmc_sniffer_inst.pio, pin_setter_sm, mux, 1, true);
    pio_sm_set_set_pins(rpmc_sniffer_inst.pio, pin_setter_sm, mux, 1);

    rpmc_sniffer_inst.cfg = rpmc_sniffer_program_get_default_config(rpmc_sniffer_inst.offset);

    // io mapping (inputs 0:svd)
    sm_config_set_in_pins(&rpmc_sniffer_inst.cfg, mosi);
    sm_config_set_in_pin_count(&rpmc_sniffer_inst.cfg, 1);

    // shifts are msb-first 32-bits
    sm_config_set_in_shift(&rpmc_sniffer_inst.cfg, false, true, 32);
    sm_config_set_out_shift(&rpmc_sniffer_inst.cfg, false, true, 32);

    // setup cs as jump pins
    sm_config_set_jmp_pin(&rpmc_sniffer_inst.cfg, cs);

    // 125 MHz
    sm_config_set_clkdiv(&rpmc_sniffer_inst.cfg, 1.0f);

    sm_config_set_set_pins(&rpmc_sniffer_inst.cfg, mux, 1);

    int rc = pio_sm_init(rpmc_sniffer_inst.pio, rpmc_sniffer_inst.sm, rpmc_sniffer_inst.offset + rpmc_sniffer_offset_start, &rpmc_sniffer_inst.cfg);
    if (rc < 0) {
        printf("Error: spi sniff sm failed to initialize!\n");
        return rc;
    }
    pio_sm_set_enabled(rpmc_sniffer_inst.pio, rpmc_sniffer_inst.sm, true);

    rpmc_sniffer_inited = true;
    // success
    return true;
}

bool interposer_pio_init(unsigned int cs, unsigned int clk, const unsigned int mosi, unsigned miso, const unsigned int mux)
{
    // TODO: switch to pio_add_program with {FIRST,SECOND}_PIO for consistency
    //       for irq prev/next
    if (!pio_claim_free_sm_and_add_program(&spi_slave_program, &interposer_inst.pio, &interposer_inst.sm, &interposer_inst.offset)) {
        printf("Error: SPI sniff program could not be loaded/could not claim state machine!\n");
        return false;
    }
    printf("interposer_pio: %u\n", PIO_NUM(interposer_inst.pio));
    pio_gpio_init(interposer_inst.pio, clk);
    gpio_set_input_hysteresis_enabled(clk, false);
    pio_gpio_init(interposer_inst.pio, cs);
    pio_gpio_init(interposer_inst.pio, mosi);
    gpio_set_input_hysteresis_enabled(mosi, false);
    pio_gpio_init(interposer_inst.pio, miso);
    // gpio_set_slew_rate(miso, GPIO_SLEW_RATE_FAST);
    // gpio_set_drive_strength(miso, GPIO_DRIVE_STRENGTH_12MA);

    pio_gpio_init(interposer_inst.pio, mux);
    pio_sm_set_sideset_pins(interposer_inst.pio, interposer_inst.sm, mux);

    interposer_inst.cfg = spi_slave_program_get_default_config(interposer_inst.offset);

    // io mapping (inputs 0:svd)
    sm_config_set_in_pins(&interposer_inst.cfg, mosi);
    sm_config_set_in_pin_count(&interposer_inst.cfg, 1);
    sm_config_set_out_pins(&interposer_inst.cfg, miso, 1);
    sm_config_set_set_pins(&interposer_inst.cfg, miso, 1);
    //pio_sm_set_pindirs_with_mask(interposer_inst.pio, interposer_inst.sm, 1, (1 << miso) | (1 << mux));
    pio_sm_set_consecutive_pindirs(interposer_inst.pio, interposer_inst.sm, mux, 1, true);
    pio_sm_set_consecutive_pindirs(interposer_inst.pio, interposer_inst.sm, miso, 1, true);
    sm_config_set_sideset_pin_base(&interposer_inst.cfg, mux);

    // no RX fifo -> double TX fifo
    sm_config_set_fifo_join(&interposer_inst.cfg, PIO_FIFO_JOIN_TX);
    // shift left, no autopush and threshold of 32
    sm_config_set_in_shift(&interposer_inst.cfg, false, false, 32);
    // shift left, autopull and threshold of 32
    sm_config_set_out_shift(&interposer_inst.cfg, false, true, 32);

    // setup cs as jump pins
    sm_config_set_jmp_pin(&interposer_inst.cfg, cs);

    // 125 MHz
    sm_config_set_clkdiv(&interposer_inst.cfg, 1.0f);

    int rc = pio_sm_init(interposer_inst.pio, interposer_inst.sm, interposer_inst.offset + spi_slave_offset_start, &interposer_inst.cfg);
    if (rc < 0) {
        printf("Error: spi sniff sm failed to initialize!\n");
        return rc;
    }
    pio_sm_set_enabled(interposer_inst.pio, interposer_inst.sm, true);

    interposer_inited = true;
}

inline void reverse_inplace(uint32_t *x)
{
    *x = (*x << 24) | ((*x << 8) & 0xFF0000) | ((*x >> 8) & 0xFF00) | (*x >> 24);
}

static void u32_into_u8(uint32_t *u32, uint8_t *u8, size_t count)
{
    size_t i;
    uint32_t word;

    for (i = 0; i < (count / 4); ++i) {
        word = u32[i];
        u8[i * 4 + 0] = (word >> 24) & 0xFF;
        u8[i * 4 + 1] = (word >> 16) & 0xFF;
        u8[i * 4 + 2] = (word >>  8) & 0xFF;
        u8[i * 4 + 3] = (word      ) & 0xFF;
    }

    word = u32[i];
    for (size_t j = 0; j < (count % 4); ++j)
        u8[i * 4 + j] = (word >> (24 - 8 * j)) & 0xFF;
}

static void parse_rpmc_command(struct rpmc_command_info * info)
{
    uint32_t op1 = pio_sm_get_blocking(rpmc_sniffer_inst.pio, rpmc_sniffer_inst.sm);

    uint32_t more[5];
    for (size_t i = 0; i < count_of(more); ++i)
        more[i] = pio_sm_get_blocking(rpmc_sniffer_inst.pio, rpmc_sniffer_inst.sm);
    uint32_t dword = more[0];

    uint8_t cmd_byte = (dword >> 24);

    switch (cmd_byte) {
        case 0x00:
            info->kind = WRITE_ROOT_KEY;
            return;
        case 0x01:
            info->kind = UNKNOWN;
            return;
        case 0x02:
            info->kind = INCREMENT;
            info->increment.target = (dword >> 16) & 0xFF;
            info->increment.old_value = ((more[0] & 0xFF) << 24) | ((more[1] >> 8) & 0xFFFFFF);
            return;
        case 0x03:
            // NOTE: beware that we don't have much time between a get and its
            // status, so we can't print anything here
            info->kind = GET;
            info->get.counter = (dword >> 16) & 0xFF;

            info->get.tag[0] = more[0] & 0xFF;
            u32_into_u8(&more[1], &info->get.tag[1], sizeof(info->get.tag) - 1);
            return;
        default:
            printf("Error: unknown byte, should not happen\n");
            return;
    }
}

union rpmc_request {
    struct __attribute((__packed__)) {
        uint8_t op1;
        uint8_t typ;
        uint8_t idx;
        uint8_t reserved;
        uint8_t tag[12];
        uint8_t sig[32];
    };
    uint32_t words[12];
    uint8_t buf[48];
};

#define PIN_MUX_INTERPOSE 16
static int __time_critical_func(listen_for_op1)(struct rpmc_command_info * info) {
    union rpmc_request req;

    // tell the first SM to match RPMC request commands
    pio_sm_put_blocking(rpmc_sniffer_inst.pio, rpmc_sniffer_inst.sm, 0x9B03);
    // tell the second SM to match OP2
    pio_sm_put_blocking(interposer_inst.pio, interposer_inst.sm, 0x96);
    for (unsigned n = 1; ; ++n) {
        for (unsigned i = 0; i < count_of(req.words); ++i)
            req.words[i] = pio_sm_get_blocking(rpmc_sniffer_inst.pio, rpmc_sniffer_inst.sm);

        // tell the first SM again to match RPMC request commands
        //
        // NOTE: we have to push this for every new request, because the PIO
        //   needs to use both of its scratch registers and thus overwrites the
        //   match bits (and it can't set immediate values larger than 31)
        pio_sm_put_blocking(rpmc_sniffer_inst.pio, rpmc_sniffer_inst.sm, 0x9B03);

        pio_sm_put_blocking(interposer_inst.pio, interposer_inst.sm, (8 - 1) << 1);
        pio_sm_put_blocking(interposer_inst.pio, interposer_inst.sm, 0xAAAAAAAA);

#if 0
        u32_into_u8(&req.buf[1], req.tag, sizeof(req.tag));
#else
        // TODO: it might be enough to only do this with the tag
        u32_into_u8(req.words, req.buf, sizeof(req.buf));
#endif

#if 1
        printf("request %d:\n"
               "\tidx: %02x\n"
               "\ttag: %02x%02x...%02x%02x\n",
               n, req.idx, req.tag[0], req.tag[1], req.tag[10], req.tag[11]);
        //printf("\top1: %02x\n", req.op1);
        //printf("\ttyp: %02x\n", req.typ);
        //printf("\tsig: %02x%02x...%02x%02x\n", req.sig[0], req.sig[1], req.sig[30], req.sig[31]);
#endif
    }

    return 0;
}

static int __time_critical_func(listen_for_op2_and_mux)() {
    // clear fifo
    pio_sm_clear_fifos(rpmc_sniffer_inst.pio, rpmc_sniffer_inst.sm);
    // set match byte to op2
    pio_sm_put_blocking(rpmc_sniffer_inst.pio, rpmc_sniffer_inst.sm, 0x96);

    // wait until command is received
    while (pio_sm_is_rx_fifo_empty(rpmc_sniffer_inst.pio, rpmc_sniffer_inst.sm))
        tight_loop_contents();

    return 0;
}

/*
 * TODO: when the bytecount is way bigger than what is actually written during
 * low chip select, this function takes a long time since it still writes
 * everything into the FIFO. Improve this by checking if the rx FIFO contains
 * something before every put and abort in that case. This way we could always
 * send the long status without running into delays.
 *
 * size of the buffer behind data must be at least `(count + 3) / 4 * 4` big
 */
uint32_t interposer_send(const uint8_t * data, const uint32_t count)
{
    pio_sm_put_blocking(interposer_inst.pio, interposer_inst.sm, count * 8 - 1);

    for (size_t i = 0; i < (count + 3) / 4; i++) {
         uint32_t word = 0;
         word |= data[i * 4 + 0] << 24;
         word |= data[i * 4 + 1] << 16;
         word |= data[i * 4 + 2] << 8;
         word |= data[i * 4 + 3];
        pio_sm_put_blocking(interposer_inst.pio, interposer_inst.sm, word);
    }

#if 0
    printf("after push\n");
    printf("tx empty: %d\n", pio_sm_is_tx_fifo_empty(interposer_inst.pio, interposer_inst.sm));
    printf("rx empty: %d\n", pio_sm_is_rx_fifo_empty(interposer_inst.pio, interposer_inst.sm));
#endif

    uint32_t remaining;
    remaining = pio_sm_get_blocking(interposer_inst.pio, interposer_inst.sm);

    if (!pio_sm_is_tx_fifo_empty(interposer_inst.pio, interposer_inst.sm)) {
        printf("Error: State machine FIFO should be empty\n");
    }

    return remaining + 1;
}

uint32_t interposer_send_words(const uint32_t *data, const uint32_t count)
{
    pio_sm_put_blocking(interposer_inst.pio, interposer_inst.sm, count * 4 * 8 - 1);

    for (size_t i = 0; i < count; i++)
        pio_sm_put_blocking(interposer_inst.pio, interposer_inst.sm, data[i]);

#if 0
    printf("after push\n");
    printf("tx empty: %d\n", pio_sm_is_tx_fifo_empty(interposer_inst.pio, interposer_inst.sm));
    printf("rx empty: %d\n", pio_sm_is_rx_fifo_empty(interposer_inst.pio, interposer_inst.sm));
#endif

    uint32_t remaining;
    remaining = pio_sm_get_blocking(interposer_inst.pio, interposer_inst.sm);

    if (!pio_sm_is_tx_fifo_empty(interposer_inst.pio, interposer_inst.sm)) {
        printf("Error: State machine FIFO should be empty\n");
    }

    return remaining + 1;
}

void __time_critical_func(interposer_stop)()
{
    pio_sm_set_pins(rpmc_sniffer_inst.pio, pin_setter_sm, 0);
}

%}
