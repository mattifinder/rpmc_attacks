.program increment_sniffer

; RPMC Increment Sniffer
;
; This program will wait until it sees an RPMC Increment command, sniff all of
; its bits and then notify the interposer SM.
;
; Expected pin mapping:
; - IN pin is SPI_MOSI
; - JMPPIN is SPI_CS
; - gpio 2 is SPI_CLK

; IN pin should be MOSI
.in 1 left auto 32
; No OUT pin. Disable autopull since pull only the match bits once
.out 0 left 32

; Expects PIN_PICO_BOARD_SPI_CLK to be 2
.define CLK 2

public start:
    ; Pull manually because autopull is disabled. Because we move the bits back
    ; into OSR after consuming them, we get away with doing this only once at
    ; the very beginning
    pull

.wrap_target
listen_for_match_bits:
    ; load bits to match (i.e. OP1 + Increment command type) into Y
    out y, 32

    ; Since we will have to overwrite register Y later to store something else
    ; we will loose the match bits. But since we need the match bits in every
    ; iteration we would have to either pull them again from the FIFO (requiring
    ; the C code to put them there every iteration) or we can place them back
    ; into OSR ourselves. This works because we don't have to pull any other
    ; bits from the FIFO.
    mov osr, y

match_loop:
    ; match 16 bits
    set x, 15
    ; reset ISR used in the bitloop
    mov isr, null

    ; wait for falling chip select edge
    wait 1 JMPPIN
    wait 0 JMPPIN

    ; sample the bits to match on every rising clock edge
bitloop:
    wait 1 gpio CLK
    in pins, 1
    ; make sure that the clock goes down in between
    wait 0 gpio CLK
    jmp x--, bitloop
bitloop_end:

    ; compare read bits and restart if they don't match
    mov x, isr
    jmp x!=y, match_loop
match_success:

    ; An increment command is 40 bytes long, but we're not interested in the 32
    ; bytes of signature at the end and have read already the first two, so
    ; we're still missing 6*8 bits. since we can't set immediate values larger
    ; than 31, we have to use two counters for an outer loop and an inner one.
    ; 6*8/16 = 3
    set y, 2
outerloop:
    set x, 15
innerloop:
    wait 1 gpio CLK
    ; Push the command bits out (via autopush)
    in pins, 1
    wait 0 gpio CLK
    jmp x--, innerloop
innerloop_end:
    jmp y--, outerloop
outerloop_end:

    ; notify the interposer state machine that it can start looking for OP2
    irq next clear 4

    ; jump back to listen_for_match_bits
.wrap


% c-sdk {

#include "helper.h"

static struct pio_metadata inc_sniff = { .prog = &increment_sniffer_program,
	                                 .inited = false };

static int increment_sniffer_init(const unsigned int cs, const unsigned int clk,
                                  const unsigned int mosi)
{
	// TODO: switch to pio_add_program. Does THIRD_PIO exist?
	if (!pio_claim_free_sm_and_add_program(inc_sniff.prog, &inc_sniff.pio,
	                                       &inc_sniff.sm,
	                                       &inc_sniff.offset)) {
		printf("Error: Increment sniffer program could not be loaded\n");
		return false;
	}
	PIO pio = inc_sniff.pio;
	uint sm = inc_sniff.sm;
	printf("increment_sniffer: %u\n", PIO_NUM(pio));

	pio_gpio_init(pio, clk);
	gpio_set_input_hysteresis_enabled(clk, false);
	pio_gpio_init(pio, mosi);
	gpio_set_input_hysteresis_enabled(mosi, false);
	pio_gpio_init(pio, cs);

	inc_sniff.cfg =
		increment_sniffer_program_get_default_config(inc_sniff.offset);
	pio_sm_config *cfg = &inc_sniff.cfg;

	sm_config_set_in_pin_base(cfg, mosi);
	sm_config_set_jmp_pin(cfg, cs);

	int rc = pio_sm_init(pio, sm,
	                     inc_sniff.offset + increment_sniffer_offset_start,
	                     cfg);
	if (rc < 0) {
		printf("Error: Increment sniffer SM failed to initialize\n");
		return rc;
	}
	pio_sm_set_enabled(pio, sm, true);

	return true;
}

%}
