.program increment_listener

; TODO: describe

.define CLK 2

public start:
pull_once:
    ; because we move the bits back into osr after consuming them, we get away
    ; with doing this only once
    pull

.wrap_target
listen_for_match_bits:
    ; load bits to match into y
    out y, 32

    ; Since we will have to overwrite register Y later to store something else
    ; we will loose the match bits. But since we need the match bits in every
    ; iteration we would have to either pull them again from the FIFO (requiring
    ; the C code to put them there every iteration) or we can place them back
    ; into OSR ourselves. This works because we don't have to pull any other
    ; bits from the FIFO.
    mov osr, y

match_loop:
    set x, 15                ; number of bits to match
    mov isr, null

    ; wait for falling chip select edge
    wait 1 JMPPIN
    wait 0 JMPPIN

    ; sample the bits to match into x on every rising clock edge
bitloop:
    wait 1 gpio CLK
    in pins, 1
    ; make sure that the clock goes down in between
    wait 0 gpio CLK
    jmp x--, bitloop
bitloop_end:

    ; compare read bits
    mov x, isr              ; move bits read to x
    jmp x!=y, match_loop    ; continue if bits don't match
match_success:

    ; An increment command is 40 bytes long, but we're not interested in the 32
    ; bytes of signature at the end and have read already the first two, so
    ; we're still missing 6*8 bits. since we can't set immediate values larger
    ; than 31, we have to use two counters for an outer loop and an inner one.
    ; 6*8/16 = 3
    ; NOTE: make sure the pico is fast enough for this (overclocking might be
    ;       necessary)
    set y, 2
outerloop:
    set x, 15
innerloop:
    wait 1 gpio CLK
    in pins, 1
    wait 0 gpio CLK
    jmp x--, innerloop
innerloop_end:
    jmp y--, outerloop
outerloop_end:

    ; notify the second state machine that it can start looking for OP2
    irq next clear 4

    ; wait for CS to go up again
    wait 1 JMPPIN

    ; jump back to listen_for_match_bits
.wrap


% c-sdk {

#include "helper.h"

static struct pio_metadata increment_listener = { .prog = &increment_listener_program, .inited = false};;

bool increment_listener_init(const unsigned int cs, const unsigned int clk, const unsigned int mosi)
{
    // TODO: switch to pio_add_program. Does THIRD_PIO exist?
    if (!pio_claim_free_sm_and_add_program(increment_listener.prog, &increment_listener.pio, &increment_listener.sm, &increment_listener.offset)) {
        printf("Error: Increment listener program could not be loaded/could not claim state machine!\n");
        return false;
    }
    PIO pio = increment_listener.pio;
    uint sm = increment_listener.sm;
    printf("increment_listener: %u\n", PIO_NUM(pio));

    pio_gpio_init(pio, clk);
    gpio_set_input_hysteresis_enabled(clk, false);
    pio_gpio_init(pio, mosi);
    gpio_set_input_hysteresis_enabled(mosi, false);
    pio_gpio_init(pio, cs);

    increment_listener.cfg = increment_listener_program_get_default_config(increment_listener.offset);

    // io mapping (inputs 0:svd)
    sm_config_set_in_pins(&increment_listener.cfg, mosi);
    sm_config_set_in_pin_count(&increment_listener.cfg, 1);

    // shifts are msb-first 32-bits, enable autopush but disable autopull
    sm_config_set_in_shift(&increment_listener.cfg, false, true, 32);
    sm_config_set_out_shift(&increment_listener.cfg, false, false, 32);

    // setup cs as jump pins
    sm_config_set_jmp_pin(&increment_listener.cfg, cs);

    // normal clock speed
    sm_config_set_clkdiv(&increment_listener.cfg, 1.0f);

    int rc = pio_sm_init(pio, sm, increment_listener.offset + increment_listener_offset_start, &increment_listener.cfg);
    if (rc < 0) {
        printf("Error: increment listener sm failed to initialize!\n");
        return rc;
    }
    pio_sm_set_enabled(pio, sm, true);

    return true;
}

%}
